generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                  String  @id @default(cuid())
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user                user    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model attempt {
  id              String   @id @default(cuid())
  user_id         String?
  guest_id        String?
  quiz_id         String
  score           Int
  total_questions Int
  answers         Json
  sync_status     String   @default("pending")
  created_at      DateTime @default(now())
  quiz            quiz     @relation(fields: [quiz_id], references: [id])
  user            user?    @relation(fields: [user_id], references: [id])

  @@index([guest_id])
  @@index([sync_status])
  @@index([user_id])
}

model question {
  id                String  @id @default(cuid())
  text              String
  options           Json
  correct_option_id String
  order             Int
  explanation       String?
  quiz_id           String
  quiz              quiz    @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
}

model quiz {
  id          String      @id @default(cuid())
  title       String
  description String?
  category_id String     // внешний ключ на категорию
  category    category?   @relation(fields: [category_id], references: [id])
  level       Level?      @default(JUNIOR)
  created_at  DateTime    @default(now())
  updated_at  DateTime
  attempts    attempt[]
  questions   question[]
}

model session {
  id            String   @id @default(cuid())
  session_token String   @unique
  user_id       String
  expires       DateTime
  user          user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  image          String?
  created_at     DateTime   @default(now())
  password       String?
  email_verified DateTime?
  role           String     @default("user")
  accounts       account[]
  attempts       attempt[]
  sessions       session[]
}

model verificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}



model category {
  id          String   @id @default(cuid())
  name        String   @unique
  quizzes     quiz[]  
  iconUrl String?
}

enum Level {
  JUNIOR
  MIDDLE
  SENIOR
}