generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id                  String  @id
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  users               users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
}

model attempts {
  id              String   @id
  user_id         String?
  guest_id        String?
  quiz_id         String
  score           Int
  total_questions Int
  answers         Json
  sync_status     String   @default("pending")
  created_at      DateTime @default(now())
  quizzes         quizzes  @relation(fields: [quiz_id], references: [id])
  users           users?   @relation(fields: [user_id], references: [id])

  @@index([guest_id])
  @@index([sync_status])
  @@index([user_id])
}

model questions {
  id                String  @id
  text              String
  options           Json
  correct_option_id String
  order             Int
  explanation       String?
  quiz_id           String
  quizzes           quizzes @relation(fields: [quiz_id], references: [id], onDelete: Cascade)

  @@index([quiz_id])
}

model quizzes {
  id          String      @id
  title       String
  description String?
  created_at  DateTime    @default(now())
  updated_at  DateTime
  attempts    attempts[]
  questions   questions[]
}

model sessions {
  id            String   @id
  session_token String   @unique
  user_id       String
  expires       DateTime
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id             String     @id
  email          String     @unique
  name           String?
  image          String?
  created_at     DateTime   @default(now())
  password       String?
  email_verified DateTime?
  accounts       accounts[]
  attempts       attempts[]
  sessions       sessions[]
  role String @default("user")
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
